  "cards": [
    {
      "dot": "cyan",
      "title": "Primary request path",
      "items": [
        "Staff call the public REST API; JWT and tenant access checks run in-process.",
        "The API uses control data to authorize and route tenant work to the shard."
      ]
    },
    {
      "dot": "emerald",
      "title": "Runtime dependencies",
      "items": [
        "Compose runs one PostgreSQL container with distinct control and shard logical databases.",
        "The executor is separately deployable and has only internal operational endpoints."
      ]
    },
    {
      "dot": "rose",
      "title": "Credential boundary",
      "items": [
        "The authorization binary accepts only a pinned mTLS bank client and persists no PAN or CVV.",
        "Compose configures the in-memory vault only for development/test; a production external vault is not implemented here."
      ]
    }
  ]
