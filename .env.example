# Optional development overrides. docker compose up --build works without copying this file.
APP_PORT=8080
CONTROL_DATABASE=card_issuer_control
SHARD_DATABASE=card_issuer_shard_01
SHARD_ID=shard_01
POSTGRES_PASSWORD=Dev-Postgres-Admin!2026
CONTROL_DB_PASSWORD=Dev-Control-Reader!2026
AUTH_DB_PASSWORD=Dev-Auth-Runtime!2026
SHARD_DB_PASSWORD=Dev-Shard-Runtime!2026
# Required: base64-encoded 64-byte Ed25519 private key. Keep it outside source control.
AUTH_JWT_PRIVATE_KEY_B64=
AUTH_JWT_ISSUER=card-issuer-api
AUTH_JWT_AUDIENCE=card-issuer-api
# Existing volumes retain database passwords. See README.md before changing these values.
