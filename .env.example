# Optional development overrides. docker compose up --build works without copying this file.
APP_PORT=8080
APP_ENV=development
CREDENTIAL_VAULT_MODE=development
DEVELOPMENT_VAULT_URL=http://devvault:8081
# Test-only protected key for the shared non-durable development vault; it is never usable in production.
TEST_VAULT_KEY_B64=QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI
AUTHORIZATION_PORT=8443
CONTROL_DATABASE=card_issuer_control
SHARD_DATABASE=card_issuer_shard_01
SHARD_ID=shard_01
POSTGRES_PASSWORD=Dev-Postgres-Admin!2026
CONTROL_DB_PASSWORD=Dev-Control-Reader!2026
AUTH_DB_PASSWORD=Dev-Auth-Runtime!2026
SHARD_DB_PASSWORD=Dev-Shard-Runtime!2026
EXECUTOR_DB_PASSWORD=Dev-Executor-Runtime!2026
# Must be different for each executor replica; Compose refuses to start without it.
EXECUTOR_ID=executor-dev-01
EXECUTOR_POLL_INTERVAL=1s
EXECUTOR_MAX_CLAIMS=4
EXECUTOR_PER_BANK_CONCURRENCY=1
EXECUTOR_LEASE_DURATION=30s
EXECUTOR_BATCH_MAX_ATTEMPTS=3
EXECUTOR_BATCH_INITIAL_BACKOFF=1s
EXECUTOR_BATCH_MAX_BACKOFF=30s
EXECUTOR_BATCH_SIZE_CAP=200
EXECUTOR_EXPIRY_BACKOFF=1s
EXECUTOR_DRAIN_TIMEOUT=15s
# POC-only public development key; must never be used in production.
AUTH_JWT_PRIVATE_KEY_B64=nWGxne/9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2DXWpgBgrEKt9VL/tPJZAc6DuFy89qmIyWvAhpo9wdRGg
AUTH_JWT_ISSUER=card-issuer-api
AUTH_JWT_AUDIENCE=card-issuer-api
